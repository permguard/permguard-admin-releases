entity Merchant;
entity Role;
entity Operator in [Role] = {
  merchant: Merchant,
};
entity Order = {
  merchant: Merchant,
  amountCents: Long,
  status: String,
  customerId: String,
};

action view appliesTo {
  principal: [Operator],
  resource: [Order],
  context: {},
};

action refund appliesTo {
  principal: [Operator],
  resource: [Order],
  context: {
    amountCents: Long,
    reason: String,
    mfa: Bool,
  },
};
